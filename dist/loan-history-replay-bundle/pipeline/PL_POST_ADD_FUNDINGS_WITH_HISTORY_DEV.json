                                        "type": "Expression"
                                    },
                                    "token": {
                                        "value": "@item().token",
                                        "type": "Expression"
                                    },
                                    "dbase_name": {
                                        "value": "@item().dbase_name",
                                        "type": "Expression"
                                    },
                                    "api_body": {
                                        "value": "@item().api_body",
                                        "type": "Expression"
                                    }
                                }
                            }
                        }
                    ]
                }
            },
            {
