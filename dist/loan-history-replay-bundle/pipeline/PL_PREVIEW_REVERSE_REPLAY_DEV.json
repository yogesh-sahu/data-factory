{
    "name": "PL_PREVIEW_REVERSE_REPLAY_DEV",
    "properties": {
        "description": "Preview / dry-run pipeline. Takes loan_account + effective_date + lender_code + fund_percentage + dry_run. When dry_run is TRUE: only GETs are made; the HTML report shows what would be posted. When dry_run is FALSE: also reverses, ad-funds and replays for real via PL_CHILD_REVERSE_REPLAY_DEV, with API audit captured in loan_history_replay_stage.",
        "activities": [
            {
                "name": "LOOKUP_API_CONFIG",
                "type": "Lookup",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderQuery": {
                            "value": "SELECT TOP 1 REPLACE(h.api_url, '#ACCOUNT_NO', '@{pipeline().parameters.loan_account}') AS history_url, REPLACE(l.api_url, '#ACCOUNT_NO', '@{pipeline().parameters.loan_account}') AS getloan_url, JSON_VALUE(h.api_prop, '$.Header.Token') AS token, JSON_VALUE(h.api_prop, '$.Header.Database') AS dbase_name FROM dbo.api_master h CROSS JOIN dbo.api_master l WHERE h.api_code = 'GET_LOAN_HISTORY_BY_AN' AND h.valid_flag = 'Y' AND l.api_code = 'GET_LOAN_BY_AN' AND l.valid_flag = 'Y'",
                            "type": "Expression"
                        },
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_AZURE_SQL_CAL_DEV",
                        "type": "DatasetReference",
                        "parameters": {}
                    },
                    "firstRowOnly": true
                }
            },
            {
                "name": "CALL_GET_LOAN_HISTORY",
                "type": "WebActivity",
                "dependsOn": [
                    {
                        "activity": "LOOKUP_API_CONFIG",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 3,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "GET",
                    "headers": {
                        "Token": {
                            "value": "@activity('LOOKUP_API_CONFIG').output.firstRow.token",
                            "type": "Expression"
                        },
                        "Database": {
                            "value": "@activity('LOOKUP_API_CONFIG').output.firstRow.dbase_name",
                            "type": "Expression"
                        }
                    },
                    "url": {
                        "value": "@activity('LOOKUP_API_CONFIG').output.firstRow.history_url",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "CALL_GET_LOAN",
                "type": "WebActivity",
                "dependsOn": [
                    {
                        "activity": "LOOKUP_API_CONFIG",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 3,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "GET",
                    "headers": {
                        "Token": {
                            "value": "@activity('LOOKUP_API_CONFIG').output.firstRow.token",
                            "type": "Expression"
                        },
                        "Database": {
                            "value": "@activity('LOOKUP_API_CONFIG').output.firstRow.dbase_name",
                            "type": "Expression"
                        }
                    },
                    "url": {
                        "value": "@activity('LOOKUP_API_CONFIG').output.firstRow.getloan_url",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "SET_VARIABLE_API_RESPONSE",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "CALL_GET_LOAN_HISTORY",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "varjsonstring",
                    "value": {
                        "value": "@string(concat('{',\n  '\"Data\":', string(activity('CALL_GET_LOAN_HISTORY').output.Data), ',',\n  '\"ErrorMessage\":', if(equals(activity('CALL_GET_LOAN_HISTORY').output.ErrorMessage, null), 'null', string(activity('CALL_GET_LOAN_HISTORY').output.ErrorMessage)), ',',\n  '\"ErrorNumber\":', string(activity('CALL_GET_LOAN_HISTORY').output.ErrorNumber), ',',\n  '\"Status\":', string(activity('CALL_GET_LOAN_HISTORY').output.Status),\n'}'))",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "SET_VARIABLE_LOAN_RESPONSE",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "CALL_GET_LOAN",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "varloanjson",
                    "value": {
                        "value": "@string(concat('{',\n  '\"Data\":', string(activity('CALL_GET_LOAN').output.Data), ',',\n  '\"Status\":', string(activity('CALL_GET_LOAN').output.Status),\n'}'))",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "SCR_BUILD_PREVIEW",
                "type": "Script",
                "dependsOn": [
                    {
                        "activity": "SET_VARIABLE_API_RESPONSE",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    },
                    {
                        "activity": "SET_VARIABLE_LOAN_RESPONSE",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "linkedServiceName": {
                    "referenceName": "LS_AzureSql_CAL_DEV",
                    "type": "LinkedServiceReference"
                },
                "typeProperties": {
                    "scripts": [
                        {
                            "parameters": [
                                {
                                    "name": "loan_account",
                                    "type": "String",
                                    "value": {
                                        "value": "@pipeline().parameters.loan_account",
                                        "type": "Expression"
                                    },
                                    "direction": "Input"
                                },
                                {
                                    "name": "effective_date",
                                    "type": "String",
                                    "value": {
                                        "value": "@pipeline().parameters.effective_date",
                                        "type": "Expression"
                                    },
                                    "direction": "Input"
                                },
                                {
                                    "name": "api_response",
                                    "type": "String",
                                    "value": {
                                        "value": "@variables('varjsonstring')",
                                        "type": "Expression"
                                    },
                                    "direction": "Input"
                                },
                                {
                                    "name": "lender_code",
                                    "type": "String",
                                    "value": {
                                        "value": "@pipeline().parameters.lender_code",
                                        "type": "Expression"
                                    },
                                    "direction": "Input"
                                },
                                {
                                    "name": "fund_percentage",
                                    "type": "String",
                                    "value": {
                                        "value": "@pipeline().parameters.fund_percentage",
                                        "type": "Expression"
                                    },
                                    "direction": "Input"
                                },
                                {
                                    "name": "loan_response",
                                    "type": "String",
                                    "value": {
                                        "value": "@variables('varloanjson')",
                                        "type": "Expression"
                                    },
                                    "direction": "Input"
                                },
                                {
                                    "name": "dry_run",
                                    "type": "Boolean",
                                    "value": {
                                        "value": "@pipeline().parameters.dry_run",
                                        "type": "Expression"
                                    },
                                    "direction": "Input"
                                }
                            ],
                            "type": "Query",
                            "text": "EXEC dbo.pr_preview_load_loan_history @loan_account = @loan_account, @effective_date = @effective_date, @api_response = @api_response, @lender_code = @lender_code, @fund_percentage = @fund_percentage, @loan_response = @loan_response, @dry_run = @dry_run"
                        }
                    ],
                    "scriptBlockExecutionTimeout": "02:00:00"
                }
            },
            {
                "name": "IF_REAL_EXECUTE",
                "type": "IfCondition",
                "dependsOn": [
                    {
                        "activity": "SCR_BUILD_PREVIEW",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@not(pipeline().parameters.dry_run)",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "LOOKUP_ADFUND_CONFIG",
                            "type": "Lookup",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "AzureSqlSource",
                                    "sqlReaderQuery": "SELECT TOP 1 (SELECT api_url FROM dbo.api_master WHERE api_code='POST_ADD_FUNDINGS' AND valid_flag='Y') AS adfund_url, (SELECT api_url FROM dbo.api_master WHERE api_code='POST_ADD_LOAN_HISTORY' AND valid_flag='Y') AS addloanhistory_url, JSON_VALUE(api_prop,'$.Header.Token') AS token, JSON_VALUE(api_prop,'$.Header.Database') AS dbase_name FROM dbo.api_master WHERE api_code='POST_ADD_FUNDINGS' AND valid_flag='Y'",
                                    "queryTimeout": "02:00:00",
                                    "partitionOption": "None"
                                },
                                "dataset": {
                                    "referenceName": "DS_AZURE_SQL_CAL_DEV",
                                    "type": "DatasetReference",
                                    "parameters": {}
                                },
                                "firstRowOnly": true
                            }
                        },
                        {
                            "name": "LOOKUP_INIT_BATCH",
                            "type": "Lookup",
                            "dependsOn": [
                                {
                                    "activity": "LOOKUP_ADFUND_CONFIG",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "AzureSqlSource",
                                    "sqlReaderQuery": "EXEC dbo.pr_init_replay_batch",
                                    "queryTimeout": "02:00:00",
                                    "partitionOption": "None"
                                },
                                "dataset": {
                                    "referenceName": "DS_AZURE_SQL_CAL_DEV",
                                    "type": "DatasetReference",
                                    "parameters": {}
                                },
                                "firstRowOnly": true
                            }
                        },
                        {
                            "name": "SCR_LOAD_REPLAY_STAGE",
                            "type": "Script",
                            "dependsOn": [
                                {
                                    "activity": "LOOKUP_INIT_BATCH",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "linkedServiceName": {
                                "referenceName": "LS_AzureSql_CAL_DEV",
                                "type": "LinkedServiceReference"
                            },
                            "typeProperties": {
                                "scripts": [
                                    {
                                        "parameters": [
                                            {
                                                "name": "loan_account",
                                                "type": "String",
                                                "value": {
                                                    "value": "@pipeline().parameters.loan_account",
                                                    "type": "Expression"
                                                },
                                                "direction": "Input"
                                            },
                                            {
                                                "name": "api_response",
                                                "type": "String",
                                                "value": {
                                                    "value": "@variables('varjsonstring')",
                                                    "type": "Expression"
                                                },
                                                "direction": "Input"
                                            },
                                            {
                                                "name": "replay_batch_id",
                                                "type": "String",
                                                "value": {
                                                    "value": "@activity('LOOKUP_INIT_BATCH').output.firstRow.replay_batch_id",
                                                    "type": "Expression"
                                                },
                                                "direction": "Input"
                                            },
                                            {
                                                "name": "effective_date",
                                                "type": "String",
                                                "value": {
                                                    "value": "@pipeline().parameters.effective_date",
                                                    "type": "Expression"
                                                },
                                                "direction": "Input"
                                            }
                                        ],
                                        "type": "Query",
                                        "text": "EXEC dbo.pr_load_loan_history_replay @loan_account = @loan_account, @api_response = @api_response, @replay_batch_id = @replay_batch_id, @effective_date = @effective_date"
                                    }
                                ],
                                "scriptBlockExecutionTimeout": "02:00:00"
                            }
                        },
                        {
                            "name": "LOOKUP_PREVIEW_AMOUNT",
                            "type": "Lookup",
                            "dependsOn": [
                                {
                                    "activity": "SCR_LOAD_REPLAY_STAGE",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "AzureSqlSource",
                                    "sqlReaderQuery": {
                                        "value": "SELECT TOP 1 CONVERT(varchar(30), phase2_adfunding_amount) AS adfunding_amount FROM dbo.loan_history_preview_summary WHERE loan_account = '@{pipeline().parameters.loan_account}'",
                                        "type": "Expression"
                                    },
                                    "queryTimeout": "02:00:00",
                                    "partitionOption": "None"
                                },
                                "dataset": {
                                    "referenceName": "DS_AZURE_SQL_CAL_DEV",
                                    "type": "DatasetReference",
                                    "parameters": {}
                                },
                                "firstRowOnly": true
                            }
                        },
                        {
                            "name": "EXEC_REVERSE_REPLAY",
                            "type": "ExecutePipeline",
                            "dependsOn": [
                                {
                                    "activity": "LOOKUP_PREVIEW_AMOUNT",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "pipeline": {
                                    "referenceName": "PL_CHILD_REVERSE_REPLAY_DEV",
                                    "type": "PipelineReference"
                                },
                                "waitOnCompletion": true,
                                "parameters": {
                                    "loan_account": {
                                        "value": "@pipeline().parameters.loan_account",
                                        "type": "Expression"
                                    },
                                    "replay_batch_id": {
                                        "value": "@activity('LOOKUP_INIT_BATCH').output.firstRow.replay_batch_id",
                                        "type": "Expression"
                                    },
                                    "loan_history_post_url": {
                                        "value": "@activity('LOOKUP_ADFUND_CONFIG').output.firstRow.addloanhistory_url",
                                        "type": "Expression"
                                    },
                                    "loan_history_token": {
                                        "value": "@activity('LOOKUP_ADFUND_CONFIG').output.firstRow.token",
                                        "type": "Expression"
                                    },
                                    "loan_history_dbase": {
                                        "value": "@activity('LOOKUP_ADFUND_CONFIG').output.firstRow.dbase_name",
                                        "type": "Expression"
                                    },
                                    "api_url": {
                                        "value": "@activity('LOOKUP_ADFUND_CONFIG').output.firstRow.adfund_url",
                                        "type": "Expression"
                                    },
                                    "token": {
                                        "value": "@activity('LOOKUP_ADFUND_CONFIG').output.firstRow.token",
                                        "type": "Expression"
                                    },
                                    "dbase_name": {
                                        "value": "@activity('LOOKUP_ADFUND_CONFIG').output.firstRow.dbase_name",
                                        "type": "Expression"
                                    },
                                    "api_body": {
                                        "value": "@concat('[{\"LoanAccount\":\"', pipeline().parameters.loan_account, '\",\"LenderAccount\":\"', pipeline().parameters.lender_code, '\",\"TransDate\":\"', formatDateTime(pipeline().parameters.effective_date, 'MM/dd/yyyy'), '\",\"Amount\":\"', activity('LOOKUP_PREVIEW_AMOUNT').output.firstRow.adfunding_amount, '\"}]')",
                                        "type": "Expression"
                                    }
                                }
                            }
                        },
                        {
                            "name": "SCR_REBUILD_PREVIEW",
                            "type": "Script",
                            "dependsOn": [
                                {
                                    "activity": "EXEC_REVERSE_REPLAY",
                                    "dependencyConditions": [
                                        "Succeeded",
                                        "Failed",
                                        "Completed"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "linkedServiceName": {
                                "referenceName": "LS_AzureSql_CAL_DEV",
                                "type": "LinkedServiceReference"
                            },
                            "typeProperties": {
                                "scripts": [
                                    {
                                        "parameters": [
                                            {
                                                "name": "loan_account",
                                                "type": "String",
                                                "value": {
                                                    "value": "@pipeline().parameters.loan_account",
                                                    "type": "Expression"
                                                },
                                                "direction": "Input"
                                            },
                                            {
                                                "name": "effective_date",
                                                "type": "String",
                                                "value": {
                                                    "value": "@pipeline().parameters.effective_date",
                                                    "type": "Expression"
                                                },
                                                "direction": "Input"
                                            },
                                            {
                                                "name": "api_response",
                                                "type": "String",
                                                "value": {
                                                    "value": "@variables('varjsonstring')",
                                                    "type": "Expression"
                                                },
                                                "direction": "Input"
                                            },
                                            {
                                                "name": "lender_code",
                                                "type": "String",
                                                "value": {
                                                    "value": "@pipeline().parameters.lender_code",
                                                    "type": "Expression"
                                                },
                                                "direction": "Input"
                                            },
                                            {
                                                "name": "fund_percentage",
                                                "type": "String",
                                                "value": {
                                                    "value": "@pipeline().parameters.fund_percentage",
                                                    "type": "Expression"
                                                },
                                                "direction": "Input"
                                            },
                                            {
                                                "name": "loan_response",
                                                "type": "String",
                                                "value": {
                                                    "value": "@variables('varloanjson')",
                                                    "type": "Expression"
                                                },
                                                "direction": "Input"
                                            },
                                            {
                                                "name": "dry_run",
                                                "type": "Boolean",
                                                "value": {
                                                    "value": "@bool('false')",
                                                    "type": "Expression"
                                                },
                                                "direction": "Input"
                                            }
                                        ],
                                        "type": "Query",
                                        "text": "EXEC dbo.pr_preview_load_loan_history @loan_account = @loan_account, @effective_date = @effective_date, @api_response = @api_response, @lender_code = @lender_code, @fund_percentage = @fund_percentage, @loan_response = @loan_response, @dry_run = @dry_run"
                                    }
                                ],
                                "scriptBlockExecutionTimeout": "02:00:00"
                            }
                        }
                    ]
                }
            },
            {
                "name": "COPY_WRITE_REPORT",
                "type": "Copy",
                "dependsOn": [
                    {
                        "activity": "IF_REAL_EXECUTE",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderQuery": {
                            "value": "SELECT report_html FROM dbo.loan_history_preview_summary WHERE loan_account = '@{pipeline().parameters.loan_account}'",
                            "type": "Expression"
                        },
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "sink": {
                        "type": "DelimitedTextSink",
                        "storeSettings": {
                            "type": "AzureBlobStorageWriteSettings"
                        },
                        "formatSettings": {
                            "type": "DelimitedTextWriteSettings"
                        }
                    },
                    "enableStaging": false,
                    "translator": {
                        "type": "TabularTranslator",
                        "typeConversion": true,
                        "typeConversionSettings": {
                            "allowDataTruncation": true,
                            "treatBooleanAsNumber": false
                        }
                    }
                },
                "inputs": [
                    {
                        "referenceName": "DS_AZURE_SQL_CAL_DEV",
                        "type": "DatasetReference",
                        "parameters": {}
                    }
                ],
                "outputs": [
                    {
                        "referenceName": "DS_PREVIEW_REPORT_DEV",
                        "type": "DatasetReference",
                        "parameters": {
                            "report_file_name": {
                                "value": "@concat('loan_preview_', pipeline().parameters.loan_account, '_', formatDateTime(utcNow(), 'yyyyMMdd_HHmmss'), if(pipeline().parameters.dry_run, '_dry', '_real'), '.html')",
                                "type": "Expression"
                            }
                        }
                    }
                ]
            },
            {
                "name": "LOOKUP_PREVIEW_SUMMARY",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "COPY_WRITE_REPORT",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderQuery": {
                            "value": "SELECT loan_account, borrower_name, lender_count, lender_names, selected_lender_name, effective_month, original_loan_amount, current_principal_balance, total_history_fetched, transactions_in_month, reversal_negative_posts, reversal_negative_amount, reversal_positive_posts, reversal_positive_amount, balance_after_reversal, fund_percentage, phase2_adfunding_amount, adfund_principal_share, adfund_interest_share, replay_positive_posts, replay_negative_posts FROM dbo.loan_history_preview_summary WHERE loan_account = '@{pipeline().parameters.loan_account}'",
                            "type": "Expression"
                        },
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_AZURE_SQL_CAL_DEV",
                        "type": "DatasetReference",
                        "parameters": {}
                    },
                    "firstRowOnly": true
                }
            },
            {
                "name": "LOOKUP_PREVIEW_DETAIL",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "LOOKUP_PREVIEW_SUMMARY",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderQuery": {
                            "value": "SELECT preview_id, loan_account, effective_month, in_effective_month, date_rec, source_app, pay_method, total_amount, reversal_amount, replay_amount, direction FROM dbo.loan_history_preview WHERE loan_account = '@{pipeline().parameters.loan_account}' ORDER BY date_rec, preview_id",
                            "type": "Expression"
                        },
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_AZURE_SQL_CAL_DEV",
                        "type": "DatasetReference",
                        "parameters": {}
                    },
                    "firstRowOnly": false
                }
            }
        ],
        "policy": {
            "elapsedTimeMetric": {}
