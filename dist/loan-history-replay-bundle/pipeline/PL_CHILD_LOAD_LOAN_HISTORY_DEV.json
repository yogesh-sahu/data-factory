                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 3,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "GET",
                    "headers": {
                        "Token": {
                            "value": "@pipeline().parameters.token",
                            "type": "Expression"
                        },
                        "Database": {
                            "value": "@pipeline().parameters.dbase_name",
                            "type": "Expression"
                        }
                    },
                    "url": {
                        "value": "@pipeline().parameters.getloan_url",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "SET_VARIABLE_LOAN_RESPONSE",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "CALL_GET_LOAN",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "varloanjson",
                    "value": {
                        "value": "@string(concat('{',\n  '\"Data\":', string(activity('CALL_GET_LOAN').output.Data), ',',\n  '\"Status\":', string(activity('CALL_GET_LOAN').output.Status),\n'}'))",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "SCR_COMPUTE_ADFUND_AMOUNT",
                "type": "Script",
                "dependsOn": [
                    {
                        "activity": "SET_VARIABLE_LOAN_RESPONSE",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "linkedServiceName": {
                    "referenceName": "LS_AzureSql_CAL_DEV",
                    "type": "LinkedServiceReference"
                },
                "typeProperties": {
                    "scripts": [
                        {
                            "parameters": [
                                {
                                    "name": "loan_account",
                                    "type": "String",
                                    "value": {
                                        "value": "@pipeline().parameters.loan_account",
                                        "type": "Expression"
                                    },
                                    "direction": "Input"
                                },
                                {
                                    "name": "effective_date",
                                    "type": "String",
                                    "value": {
                                        "value": "@pipeline().parameters.effective_date",
                                        "type": "Expression"
                                    },
                                    "direction": "Input"
                                },
                                {
                                    "name": "replay_batch_id",
                                    "type": "String",
                                    "value": {
                                        "value": "@pipeline().parameters.replay_batch_id",
                                        "type": "Expression"
                                    },
                                    "direction": "Input"
                                },
                                {
                                    "name": "fund_percentage",
                                    "type": "String",
                                    "value": {
                                        "value": "@pipeline().parameters.fund_percentage",
                                        "type": "Expression"
                                    },
                                    "direction": "Input"
                                },
                                {
                                    "name": "loan_response",
                                    "type": "String",
                                    "value": {
                                        "value": "@variables('varloanjson')",
                                        "type": "Expression"
                                    },
                                    "direction": "Input"
                                }
                            ],
                            "type": "Query",
                            "text": "EXEC dbo.pr_compute_adfund_amount @loan_account = @loan_account, @effective_date = @effective_date, @replay_batch_id = @replay_batch_id, @fund_percentage = @fund_percentage, @loan_response = @loan_response"
                        }
                    ],
                    "scriptBlockExecutionTimeout": "02:00:00"
                }
            }
        ],
        "policy": {
            "elapsedTimeMetric": {}
        },
        "parameters": {
            "loan_account": {
                "type": "string"
            },
            "replay_batch_id": {
                "type": "string"
            },
            "history_url": {
                "type": "string"
            },
            "getloan_url": {
                "type": "string"
            },
            "token": {
                "type": "string"
            },
            "dbase_name": {
                "type": "string"
            },
            "effective_date": {
                "type": "string"
            },
            "fund_percentage": {
                "type": "string"
            }
