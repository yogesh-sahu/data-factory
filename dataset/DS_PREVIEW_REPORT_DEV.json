{
    "name": "[concat(parameters('factoryName'), '/DS_PREVIEW_REPORT_DEV')]",
    "type": "Microsoft.DataFactory/factories/datasets",
    "apiVersion": "2018-06-01",
    "properties": {
        "description": "Output target for the loan-history preview HTML report. quoteChar/escapeChar empty so the report_html column is written verbatim as an .html file.",
        "linkedServiceName": {
            "referenceName": "LS_ADDFUNDING",
            "type": "LinkedServiceReference"
        },
        "parameters": {
            "report_file_name": {
                "type": "string"
            }
        },
        "annotations": [],
        "type": "DelimitedText",
        "typeProperties": {
            "location": {
                "type": "AzureBlobStorageLocation",
                "fileName": {
                    "value": "@dataset().report_file_name",
                    "type": "Expression"
                },
                "container": "dev-add-funding-processed"
            },
            "columnDelimiter": ",",
            "escapeChar": "",
            "firstRowAsHeader": false,
            "quoteChar": ""
        },
        "schema": []
    },
    "dependsOn": [
        "[concat(variables('factoryId'), '/linkedServices/LS_ADDFUNDING')]"
    ]
}
