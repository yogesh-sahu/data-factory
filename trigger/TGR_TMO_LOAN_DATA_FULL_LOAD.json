    "apiVersion": "2018-06-01",
    "properties": {
        "description": "Trigger to pull the TMO loan data by timestamp on daily basis",
        "annotations": [],
        "runtimeState": "Started",
        "pipelines": [
            {
                "pipelineReference": {
                    "referenceName": "PL_LOAD_LOAN_DETAIL_FULL",
                    "type": "PipelineReference"
                },
                "parameters": {}
            }
        ],
        "type": "ScheduleTrigger",
        "typeProperties": {
