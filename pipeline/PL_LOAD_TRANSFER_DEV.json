{
    "name": "[concat(parameters('factoryName'), '/PL_LOAD_TRANSFER_DEV')]",
    "type": "Microsoft.DataFactory/factories/pipelines",
    "apiVersion": "2018-06-01",
    "properties": {
        "description": "Multi-loan transfer batch. Reads transfers/Loan_Transfer.xlsx (one row per loan), then for each loan runs the validated PL_PREVIEW_REVERSE_REPLAY_DEV with dry_run=false (reverse -> measured multi-leg transfer -> replay). Deletes the file after processing to prevent re-posting.",
        "activities": [
            {
                "name": "CHECK_IF_FILE_EXISTS",
                "type": "GetMetadata",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "dataset": {
                        "referenceName": "DS_TRANSFER_INPUT",
                        "type": "DatasetReference",
                        "parameters": {}
                    },
                    "fieldList": [
                        "exists"
                    ],
                    "storeSettings": {
                        "type": "AzureBlobStorageReadSettings",
                        "recursive": true,
                        "enablePartitionDiscovery": false
                    }
                }
            },
            {
                "name": "If Condition1",
                "type": "IfCondition",
                "dependsOn": [
                    {
                        "activity": "CHECK_IF_FILE_EXISTS",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@activity('CHECK_IF_FILE_EXISTS').output.exists",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "COPY_TO_STAGING",
                            "type": "Copy",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "ExcelSource",
                                    "storeSettings": {
                                        "type": "AzureBlobStorageReadSettings",
                                        "recursive": true,
                                        "enablePartitionDiscovery": false
                                    }
                                },
                                "sink": {
                                    "type": "AzureSqlSink",
                                    "preCopyScript": "TRUNCATE TABLE dbo.stg_loan_transfer",
                                    "writeBehavior": "insert",
                                    "sqlWriterUseTableLock": false,
                                    "disableMetricsCollection": false
                                },
                                "enableStaging": false,
                                "translator": {
                                    "type": "TabularTranslator",
                                    "mappings": [
                                        {
                                            "source": {
                                                "name": "AccountNo",
                                                "type": "String"
                                            },
                                            "sink": {
                                                "name": "account_no",
                                                "type": "String"
                                            }
                                        },
                                        {
                                            "source": {
                                                "name": "LenderCode",
                                                "type": "String"
                                            },
                                            "sink": {
                                                "name": "lender_code",
                                                "type": "String"
                                            }
                                        },
                                        {
                                            "source": {
                                                "name": "AdjustmentType",
                                                "type": "String"
                                            },
                                            "sink": {
                                                "name": "adjustment_type",
                                                "type": "String"
                                            }
                                        },
                                        {
                                            "source": {
                                                "name": "FundPercentage",
                                                "type": "String"
                                            },
                                            "sink": {
                                                "name": "fund_percentage",
                                                "type": "String"
                                            }
                                        },
                                        {
                                            "source": {
                                                "name": "EffectiveDate",
                                                "type": "String"
                                            },
                                            "sink": {
                                                "name": "effective_date",
                                                "type": "String"
                                            }
                                        }
                                    ],
                                    "typeConversion": true,
                                    "typeConversionSettings": {
                                        "allowDataTruncation": true,
                                        "treatBooleanAsNumber": false
                                    }
                                }
                            },
                            "inputs": [
                                {
                                    "referenceName": "DS_TRANSFER_INPUT",
                                    "type": "DatasetReference",
                                    "parameters": {}
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "DS_AZURE_SQL_CAL_DEV",
                                    "type": "DatasetReference",
                                    "parameters": {}
                                }
                            ]
                        },
                        {
                            "name": "EXEC_TRANSFER_FOREACH",
                            "type": "ExecutePipeline",
                            "dependsOn": [
                                {
                                    "activity": "COPY_TO_STAGING",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "pipeline": {
                                    "referenceName": "PL_CHILD_TRANSFER_FOREACH_DEV",
                                    "type": "PipelineReference"
                                },
                                "waitOnCompletion": true,
                                "parameters": {}
                            }
                        },
                        {
                            "name": "DELETE_SOURCE_FILE",
                            "type": "Delete",
                            "dependsOn": [
                                {
                                    "activity": "EXEC_TRANSFER_FOREACH",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "dataset": {
                                    "referenceName": "DS_TRANSFER_INPUT",
                                    "type": "DatasetReference",
                                    "parameters": {}
                                },
                                "enableLogging": false,
                                "storeSettings": {
                                    "type": "AzureBlobStorageReadSettings",
                                    "recursive": true,
                                    "enablePartitionDiscovery": false
                                }
                            }
                        }
                    ]
                }
            }
        ],
        "policy": {
            "elapsedTimeMetric": {}
        },
        "folder": {
            "name": "CAL_DEV"
        },
        "annotations": []
    },
    "dependsOn": [
        "[concat(variables('factoryId'), '/datasets/DS_TRANSFER_INPUT')]",
        "[concat(variables('factoryId'), '/datasets/DS_AZURE_SQL_CAL_DEV')]",
        "[concat(variables('factoryId'), '/pipelines/PL_CHILD_TRANSFER_FOREACH_DEV')]"
    ]
}