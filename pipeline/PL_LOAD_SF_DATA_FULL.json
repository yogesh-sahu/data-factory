{
    "name": "[concat(parameters('factoryName'), '/PL_LOAD_SF_DATA_FULL')]",
    "type": "Microsoft.DataFactory/factories/pipelines",
    "apiVersion": "2018-06-01",
    "properties": {
        "description": "Move salesforce data to Azure cloud",
        "activities": [
            {
                "name": "LOOKUP_SALESFORCE_ENTITY_DETAILS",
                "description": "GET SF objects to load",
                "type": "Lookup",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 3,
                    "retryIntervalInSeconds": 60,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderQuery": "SELECT * FROM vw_sf_obj_data_full",
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_AZURE_SQL_CAL_FULL",
                        "type": "DatasetReference",
                        "parameters": {}
                    },
                    "firstRowOnly": false
                }
            },
            {
                "name": "ForEach1",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "LOOKUP_SALESFORCE_ENTITY_DETAILS",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('LOOKUP_SALESFORCE_ENTITY_DETAILS').output.value",
                        "type": "Expression"
                    },
                    "isSequential": true,
                    "activities": [
                        {
                            "name": "EXEC_PL_CHILD_PROCESS_SF_DETAILS",
                            "description": "Call child pipeline to load salesforce data",
                            "type": "ExecutePipeline",
                            "dependsOn": [],
                            "policy": {
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "pipeline": {
                                    "referenceName": "PL_CHILD_PROCESS_SF_DELTA_LOAD_FULL",
                                    "type": "PipelineReference"
                                },
                                "waitOnCompletion": true,
                                "parameters": {
                                    "src_obj_id": {
                                        "value": "@item().src_obj_id",
                                        "type": "Expression"
                                    },
                                    "src_obj_uid": {
                                        "value": "@item().src_obj_uid",
                                        "type": "Expression"
                                    },
                                    "stg_obj_name": {
                                        "value": "@item().stg_obj_name",
                                        "type": "Expression"
                                    },
                                    "batch_id": {
                                        "value": "@item().batch_id",
                                        "type": "Expression"
                                    },
                                    "src_obj_col_name": {
                                        "value": "@item().src_obj_col_name",
                                        "type": "Expression"
                                    },
                                    "DataFetchSql": {
                                        "value": "@item().DataFetchSql",
                                        "type": "Expression"
                                    },
                                    "Directory": {
                                        "value": "@pipeline().parameters.Directory",
                                        "type": "Expression"
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        ],
        "policy": {
            "elapsedTimeMetric": {}
        },
        "parameters": {
            "Directory": {
                "type": "string",
                "defaultValue": "Salesforce_full"
            }
        },
        "folder": {
            "name": "PROD_FULL"
        },
        "annotations": [],
        "lastPublishTime": "2026-03-06T10:50:10Z"
    },
    "dependsOn": [
        "[concat(variables('factoryId'), '/datasets/DS_AZURE_SQL_CAL_FULL')]",
        "[concat(variables('factoryId'), '/pipelines/PL_CHILD_PROCESS_SF_DELTA_LOAD_FULL')]"
    ]
}