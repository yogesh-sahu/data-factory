{
    "name": "[concat(parameters('factoryName'), '/PL_CHILD_POST_ADD_FUNDINGS')]",
    "type": "Microsoft.DataFactory/factories/pipelines",
    "apiVersion": "2018-06-01",
    "properties": {
        "description": "This pipeline calls the post API add fundings.",
        "activities": [
            {
                "name": "CALL_ADD_FUNDINGS_API",
                "type": "WebActivity",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 3,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "POST",
                    "headers": {
                        "Token": {
                            "value": "@pipeline().parameters.token",
                            "type": "Expression"
                        },
                        "Database": {
                            "value": "@pipeline().parameters.dbase_name",
                            "type": "Expression"
                        }
                    },
                    "url": {
                        "value": "@pipeline().parameters.api_url",
                        "type": "Expression"
                    },
                    "body": {
                        "value": "@pipeline().parameters.api_body",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "SCR_UPDATE_FUND_ADJUSTMENT_DETAIL",
                "type": "Script",
                "dependsOn": [
                    {
                        "activity": "SET_VARIABLE_API_RESPONSE",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "linkedServiceName": {
                    "referenceName": "LS_AzureSql_CAL",
                    "type": "LinkedServiceReference"
                },
                "typeProperties": {
                    "scripts": [
                        {
                            "parameters": [
                                {
                                    "name": "api_response",
                                    "type": "String",
                                    "value": {
                                        "value": "@variables('varjsonstring')",
                                        "type": "Expression"
                                    },
                                    "direction": "Input"
                                },
                                {
                                    "name": "account_no",
                                    "type": "String",
                                    "value": {
                                        "value": "@pipeline().parameters.account_no",
                                        "type": "Expression"
                                    },
                                    "direction": "Input"
                                }
                            ],
                            "type": "Query",
                            "text": {
                                "value": "UPDATE fund_adjustment_detail SET is_processed = 1,process_status = 'PS',process_status_desc = 'Processed Successfully',api_response = @api_response,adjustment_posted_on= GETDATE() WHERE is_processed = 0 AND account_no = @account_no",
                                "type": "Expression"
                            }
                        }
                    ],
                    "scriptBlockExecutionTimeout": "02:00:00"
                }
            },
            {
                "name": "SET_VARIABLE_API_RESPONSE",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "CALL_ADD_FUNDINGS_API",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "varjsonstring",
                    "value": {
                        "value": "@string(concat('{',\n  '\"Data\":', string(activity('CALL_ADD_FUNDINGS_API').output.Data), ',',\n  '\"ErrorMessage\":', if(equals(activity('CALL_ADD_FUNDINGS_API').output.ErrorMessage, null), 'null', string(activity('CALL_ADD_FUNDINGS_API').output.ErrorMessage)), ',',\n  '\"ErrorNumber\":', string(activity('CALL_ADD_FUNDINGS_API').output.ErrorNumber), ',',\n  '\"Status\":', string(activity('CALL_ADD_FUNDINGS_API').output.Status),\n'}'))",
                        "type": "Expression"
                    }
                }
            }
        ],
        "policy": {
            "elapsedTimeMetric": {}
        },
        "parameters": {
            "api_url": {
                "type": "string"
            },
            "token": {
                "type": "string"
            },
            "dbase_name": {
                "type": "string"
            },
            "account_no": {
                "type": "string"
            },
            "api_body": {
                "type": "string"
            }
        },
        "variables": {
            "varjsonstring": {
                "type": "String"
            }
        },
        "folder": {
            "name": "CAL_PROD"
        },
        "annotations": [],
        "lastPublishTime": "2025-10-29T08:53:59Z"
    },
    "dependsOn": [
        "[concat(variables('factoryId'), '/linkedServices/LS_AzureSql_CAL')]"
    ]
}