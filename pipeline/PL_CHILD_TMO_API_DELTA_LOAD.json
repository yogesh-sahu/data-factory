{
    "name": "[concat(parameters('factoryName'), '/PL_CHILD_TMO_API_DELTA_LOAD')]",
    "type": "Microsoft.DataFactory/factories/pipelines",
    "apiVersion": "2018-06-01",
    "properties": {
        "activities": [
            {
                "name": "UTL_OFFSET",
                "description": "Until loop till data is received from API response",
                "type": "Until",
                "dependsOn": [
                    {
                        "activity": "SET_OFFSET_VARIABLE",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@equals(variables('VarRunpipeline'),1)",
                        "type": "Expression"
                    },
                    "activities": [
                        {
                            "name": "GET_API_RESPONSE",
                            "type": "WebActivity",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 3,
                                "retryIntervalInSeconds": 60,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "method": "GET",
                                "headers": {
                                    "Token": {
                                        "value": "@pipeline().parameters.token",
                                        "type": "Expression"
                                    },
                                    "Database": {
                                        "value": "@pipeline().parameters.dbase_name",
                                        "type": "Expression"
                                    },
                                    "offset": {
                                        "value": "@variables('VarOffset')",
                                        "type": "Expression"
                                    },
                                    "pagesize": {
                                        "value": "@pipeline().parameters.page_size",
                                        "type": "Expression"
                                    }
                                },
                                "httpRequestTimeout": "00:10:00",
                                "url": {
                                    "value": "@pipeline().parameters.api_url",
                                    "type": "Expression"
                                },
                                "connectVia": {
                                    "referenceName": "CAL-AutoResolveintegrationRuntime",
                                    "type": "IntegrationRuntimeReference"
                                }
                            }
                        },
                        {
                            "name": "SP_CALL_CURATE_API_DATA_SUCCESS",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [
                                {
                                    "activity": "GET_API_RESPONSE",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 3,
                                "retryIntervalInSeconds": 60,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "storedProcedureName": "dbo.pr_curate_api_data",
                                "storedProcedureParameters": {
                                    "ApiRk": {
                                        "value": {
                                            "value": "@pipeline().parameters.api_rk",
                                            "type": "Expression"
                                        },
                                        "type": "Int32"
                                    },
                                    "APIRequest": {
                                        "value": {
                                            "value": "@concat(\npipeline().parameters.api_url,',pagesize =',string(pipeline().parameters.page_size),',offset =',variables('VarOffset'))",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "APIResponse": {
                                        "value": {
                                            "value": "@string(activity('GET_API_RESPONSE').output)",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "IsError": {
                                        "value": "0",
                                        "type": "Int16"
                                    },
                                    "RequestedBy": {
                                        "value": {
                                            "value": "@pipeline().TriggeredByPipelineName",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "Mode": {
                                        "value": "A",
                                        "type": "String"
                                    },
                                    "APIKeyValue": {
                                        "value": {
                                            "value": "@pipeline().parameters.api_key_value",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "APIBatchId": {
                                        "value": {
                                            "value": "@pipeline().parameters.batch_id",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    }
                                }
                            },
                            "linkedServiceName": {
                                "referenceName": "LS_AzureSql_CAL",
                                "type": "LinkedServiceReference"
                            }
                        },
                        {
                            "name": "SP_CALL_CURATE_API_DATA_FAIL",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [
                                {
                                    "activity": "GET_API_RESPONSE",
                                    "dependencyConditions": [
                                        "Failed"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 3,
                                "retryIntervalInSeconds": 60,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "storedProcedureName": "dbo.pr_curate_api_data",
                                "storedProcedureParameters": {
                                    "ApiRk": {
                                        "value": {
                                            "value": "@pipeline().parameters.api_rk",
                                            "type": "Expression"
                                        },
                                        "type": "Int32"
                                    },
                                    "APIRequest": {
                                        "value": {
                                            "value": "@pipeline().parameters.api_url",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "APIResponse": {
                                        "value": {
                                            "value": "@activity('GET_API_RESPONSE').output",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "IsError": {
                                        "value": "1",
                                        "type": "Int16"
                                    },
                                    "RequestedBy": {
                                        "value": {
                                            "value": "@pipeline().TriggeredByPipelineName",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "Mode": {
                                        "value": "A",
                                        "type": "String"
                                    },
                                    "APIKeyValue": {
                                        "value": {
                                            "value": "@pipeline().parameters.api_key_value",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "APIBatchId": {
                                        "value": {
                                            "value": "@pipeline().parameters.batch_id",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    }
                                }
                            },
                            "linkedServiceName": {
                                "referenceName": "LS_AzureSql_CAL",
                                "type": "LinkedServiceReference"
                            }
                        },
                        {
                            "name": "If Condition1",
                            "type": "IfCondition",
                            "dependsOn": [
                                {
                                    "activity": "SP_CALL_CURATE_API_DATA_SUCCESS",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "userProperties": [],
                            "typeProperties": {
                                "expression": {
                                    "value": "@contains(string(activity('GET_API_RESPONSE').output),'\"Data\":[]')",
                                    "type": "Expression"
                                },
                                "ifFalseActivities": [
                                    {
                                        "name": "INCREMENT_OFFSET_VARIABLE_VALUE",
                                        "type": "SetVariable",
                                        "dependsOn": [
                                            {
                                                "activity": "LKP_GET_OFFSET_COUNTER",
                                                "dependencyConditions": [
                                                    "Succeeded"
                                                ]
                                            }
                                        ],
                                        "policy": {
                                            "secureOutput": false,
                                            "secureInput": false
                                        },
                                        "userProperties": [],
                                        "typeProperties": {
                                            "variableName": "VarOffset",
                                            "value": {
                                                "value": "@mul(activity('LKP_GET_OFFSET_COUNTER').output.firstRow.Cnt,pipeline().parameters.page_size)",
                                                "type": "Expression"
                                            }
                                        }
                                    },
                                    {
                                        "name": "LKP_GET_OFFSET_COUNTER",
                                        "description": "Get the count from the offset_counter table",
                                        "type": "Lookup",
                                        "dependsOn": [],
                                        "policy": {
                                            "timeout": "0.12:00:00",
                                            "retry": 3,
                                            "retryIntervalInSeconds": 60,
                                            "secureOutput": false,
                                            "secureInput": false
                                        },
                                        "userProperties": [],
                                        "typeProperties": {
                                            "source": {
                                                "type": "AzureSqlSource",
                                                "sqlReaderQuery": {
                                                    "value": "@concat('SELECT COUNT(1) AS Cnt FROM offset_counter WHERE pipeline_name =','''', \n    pipeline().TriggeredByPipelineName,\n    '''', 'AND key_value =','''', \n    pipeline().parameters.api_key_value, \n    '''','; SELECT getdate();'\n)",
                                                    "type": "Expression"
                                                },
                                                "queryTimeout": "02:00:00",
                                                "partitionOption": "None"
                                            },
                                            "dataset": {
                                                "referenceName": "DS_AZURE_SQL_CAL",
                                                "type": "DatasetReference",
                                                "parameters": {}
                                            },
                                            "firstRowOnly": true
                                        }
                                    }
                                ],
                                "ifTrueActivities": [
                                    {
                                        "name": "SET_RUN_PIPELINE_VARIABLE_TO_0",
                                        "type": "SetVariable",
                                        "dependsOn": [],
                                        "policy": {
                                            "secureOutput": false,
                                            "secureInput": false
                                        },
                                        "userProperties": [],
                                        "typeProperties": {
                                            "variableName": "VarRunpipeline",
                                            "value": 1
                                        }
                                    }
                                ]
                            }
                        }
                    ],
                    "timeout": "0.12:00:00"
                }
            },
            {
                "name": "SET_OFFSET_VARIABLE",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "LKP_DELETE_OFFSET_TABLE",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "VarOffset",
                    "value": {
                        "value": "@pipeline().parameters.off_set",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "LKP_DELETE_OFFSET_TABLE",
                "description": "DELETE data from offset_counter table based on the parent pipeline name",
                "type": "Lookup",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 3,
                    "retryIntervalInSeconds": 60,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderQuery": {
                            "value": "@concat('DELETE FROM offset_counter WHERE pipeline_name =','''', \n    pipeline().TriggeredByPipelineName,\n    '''', 'AND key_value =','''', \n    pipeline().parameters.api_key_value, \n    '''','; SELECT 1;'\n)\n",
                            "type": "Expression"
                        },
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_AZURE_SQL_CAL",
                        "type": "DatasetReference",
                        "parameters": {}
                    },
                    "firstRowOnly": true
                }
            }
        ],
        "policy": {
            "elapsedTimeMetric": {}
        },
        "parameters": {
            "api_rk": {
                "type": "int"
            },
            "api_url": {
                "type": "string"
            },
            "token": {
                "type": "string"
