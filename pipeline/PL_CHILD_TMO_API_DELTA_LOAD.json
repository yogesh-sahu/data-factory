                "type": "int"
            },
            "batch_id": {
                "type": "string"
            }
        },
        "variables": {
            "VarRunpipeline": {
                "type": "Integer",
                "defaultValue": 0
            },
            "VarOffset": {
                "type": "Integer",
                "defaultValue": 0
            }
        },
        "folder": {
            "name": "CAL_PROD"
        },
