{
    "name": "[concat(parameters('factoryName'), '/PL_PREVIEW_REVERSE_REPLAY_DEV')]",
    "type": "Microsoft.DataFactory/factories/pipelines",
    "apiVersion": "2018-06-01",
    "properties": {
        "description": "Dry-run preview. Enter loan_account + effective_date; fetches GetLoanHistory and GetLoan (read-only GETs, no POSTs), fills loan_history_preview / loan_history_preview_summary, and writes an HTML report to blob.",
        "activities": [
            {
                "name": "LOOKUP_API_CONFIG",
                "type": "Lookup",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderQuery": {
                            "value": "SELECT TOP 1 REPLACE(h.api_url, '#ACCOUNT_NO', '@{pipeline().parameters.loan_account}') AS history_url, REPLACE(l.api_url, '#ACCOUNT_NO', '@{pipeline().parameters.loan_account}') AS getloan_url, JSON_VALUE(h.api_prop, '$.Header.Token') AS token, JSON_VALUE(h.api_prop, '$.Header.Database') AS dbase_name FROM dbo.api_master h CROSS JOIN dbo.api_master l WHERE h.api_code = 'GET_LOAN_HISTORY_BY_AN' AND h.valid_flag = 'Y' AND l.api_code = 'GET_LOAN_BY_AN' AND l.valid_flag = 'Y'",
                            "type": "Expression"
                        },
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_AZURE_SQL_CAL_DEV",
                        "type": "DatasetReference",
                        "parameters": {}
                    },
                    "firstRowOnly": true
                }
            },
            {
                "name": "CALL_GET_LOAN_HISTORY",
                "type": "WebActivity",
                "dependsOn": [
                    {
                        "activity": "LOOKUP_API_CONFIG",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 3,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "GET",
                    "headers": {
                        "Token": {
                            "value": "@activity('LOOKUP_API_CONFIG').output.firstRow.token",
                            "type": "Expression"
                        },
                        "Database": {
                            "value": "@activity('LOOKUP_API_CONFIG').output.firstRow.dbase_name",
                            "type": "Expression"
                        }
                    },
                    "url": {
                        "value": "@activity('LOOKUP_API_CONFIG').output.firstRow.history_url",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "CALL_GET_LOAN",
                "type": "WebActivity",
                "dependsOn": [
                    {
                        "activity": "LOOKUP_API_CONFIG",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 3,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "GET",
                    "headers": {
                        "Token": {
                            "value": "@activity('LOOKUP_API_CONFIG').output.firstRow.token",
                            "type": "Expression"
                        },
                        "Database": {
                            "value": "@activity('LOOKUP_API_CONFIG').output.firstRow.dbase_name",
                            "type": "Expression"
                        }
                    },
                    "url": {
                        "value": "@activity('LOOKUP_API_CONFIG').output.firstRow.getloan_url",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "SET_VARIABLE_API_RESPONSE",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "CALL_GET_LOAN_HISTORY",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "varjsonstring",
                    "value": {
                        "value": "@string(concat('{',\n  '\"Data\":', string(activity('CALL_GET_LOAN_HISTORY').output.Data), ',',\n  '\"ErrorMessage\":', if(equals(activity('CALL_GET_LOAN_HISTORY').output.ErrorMessage, null), 'null', string(activity('CALL_GET_LOAN_HISTORY').output.ErrorMessage)), ',',\n  '\"ErrorNumber\":', string(activity('CALL_GET_LOAN_HISTORY').output.ErrorNumber), ',',\n  '\"Status\":', string(activity('CALL_GET_LOAN_HISTORY').output.Status),\n'}'))",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "SET_VARIABLE_LOAN_RESPONSE",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "CALL_GET_LOAN",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "varloanjson",
                    "value": {
                        "value": "@string(concat('{',\n  '\"Data\":', string(activity('CALL_GET_LOAN').output.Data), ',',\n  '\"Status\":', string(activity('CALL_GET_LOAN').output.Status),\n'}'))",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "SCR_BUILD_PREVIEW",
                "type": "Script",
                "dependsOn": [
                    {
                        "activity": "SET_VARIABLE_API_RESPONSE",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    },
                    {
                        "activity": "SET_VARIABLE_LOAN_RESPONSE",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "linkedServiceName": {
                    "referenceName": "LS_AzureSql_CAL_DEV",
                    "type": "LinkedServiceReference"
                },
                "typeProperties": {
                    "scripts": [
                        {
                            "parameters": [
                                {
                                    "name": "loan_account",
                                    "type": "String",
                                    "value": {
                                        "value": "@pipeline().parameters.loan_account",
                                        "type": "Expression"
                                    },
                                    "direction": "Input"
                                },
                                {
                                    "name": "effective_date",
                                    "type": "String",
                                    "value": {
                                        "value": "@pipeline().parameters.effective_date",
                                        "type": "Expression"
                                    },
                                    "direction": "Input"
                                },
                                {
                                    "name": "api_response",
                                    "type": "String",
                                    "value": {
                                        "value": "@variables('varjsonstring')",
                                        "type": "Expression"
                                    },
                                    "direction": "Input"
                                },
                                {
                                    "name": "lender_code",
                                    "type": "String",
                                    "value": {
                                        "value": "@pipeline().parameters.lender_code",
                                        "type": "Expression"
                                    },
                                    "direction": "Input"
                                },
                                {
                                    "name": "fund_percentage",
                                    "type": "String",
                                    "value": {
                                        "value": "@pipeline().parameters.fund_percentage",
                                        "type": "Expression"
                                    },
                                    "direction": "Input"
                                },
                                {
                                    "name": "loan_response",
                                    "type": "String",
                                    "value": {
                                        "value": "@variables('varloanjson')",
                                        "type": "Expression"
                                    },
                                    "direction": "Input"
                                }
                            ],
                            "type": "Query",
                            "text": "EXEC dbo.pr_preview_load_loan_history @loan_account = @loan_account, @effective_date = @effective_date, @api_response = @api_response, @lender_code = @lender_code, @fund_percentage = @fund_percentage, @loan_response = @loan_response"
                        }
                    ],
                    "scriptBlockExecutionTimeout": "02:00:00"
                }
            },
            {
                "name": "COPY_WRITE_REPORT",
                "type": "Copy",
                "dependsOn": [
                    {
                        "activity": "SCR_BUILD_PREVIEW",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderQuery": {
                            "value": "SELECT report_html FROM dbo.loan_history_preview_summary WHERE loan_account = '@{pipeline().parameters.loan_account}'",
                            "type": "Expression"
                        },
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "sink": {
                        "type": "DelimitedTextSink",
                        "storeSettings": {
                            "type": "AzureBlobStorageWriteSettings"
                        },
                        "formatSettings": {
                            "type": "DelimitedTextWriteSettings"
                        }
                    },
                    "enableStaging": false,
                    "translator": {
                        "type": "TabularTranslator",
                        "typeConversion": true,
                        "typeConversionSettings": {
                            "allowDataTruncation": true,
                            "treatBooleanAsNumber": false
                        }
                    }
                },
                "inputs": [
                    {
                        "referenceName": "DS_AZURE_SQL_CAL_DEV",
                        "type": "DatasetReference",
                        "parameters": {}
                    }
                ],
                "outputs": [
                    {
                        "referenceName": "DS_PREVIEW_REPORT_DEV",
                        "type": "DatasetReference",
                        "parameters": {
                            "report_file_name": {
                                "value": "@concat('loan_preview_', pipeline().parameters.loan_account, '_', formatDateTime(utcNow(), 'yyyyMMdd_HHmmss'), '.html')",
                                "type": "Expression"
                            }
                        }
                    }
                ]
            },
            {
                "name": "LOOKUP_PREVIEW_SUMMARY",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "SCR_BUILD_PREVIEW",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderQuery": {
                            "value": "SELECT loan_account, borrower_name, effective_month, original_loan_amount, current_principal_balance, total_history_fetched, transactions_in_month, reversal_negative_posts, reversal_negative_amount, reversal_positive_posts, reversal_positive_amount, balance_after_reversal, phase2_adfunding_amount, replay_positive_posts, replay_negative_posts FROM dbo.loan_history_preview_summary WHERE loan_account = '@{pipeline().parameters.loan_account}'",
                            "type": "Expression"
                        },
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_AZURE_SQL_CAL_DEV",
                        "type": "DatasetReference",
                        "parameters": {}
                    },
                    "firstRowOnly": true
                }
            },
            {
                "name": "LOOKUP_PREVIEW_DETAIL",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "LOOKUP_PREVIEW_SUMMARY",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderQuery": {
                            "value": "SELECT preview_id, loan_account, effective_month, date_rec, source_app, pay_method, total_amount, reversal_amount, replay_amount, direction FROM dbo.loan_history_preview WHERE loan_account = '@{pipeline().parameters.loan_account}' ORDER BY date_rec, preview_id",
                            "type": "Expression"
                        },
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_AZURE_SQL_CAL_DEV",
                        "type": "DatasetReference",
                        "parameters": {}
                    },
                    "firstRowOnly": false
                }
            }
        ],
        "policy": {
            "elapsedTimeMetric": {}
        },
        "parameters": {
            "loan_account": {
                "type": "string"
            },
            "effective_date": {
                "type": "string"
            },
            "lender_code": {
                "type": "string"
            },
            "fund_percentage": {
                "type": "string",
                "defaultValue": "1.00"
            }
        },
        "variables": {
            "varjsonstring": {
                "type": "String"
            },
            "varloanjson": {
                "type": "String"
            }
        },
        "folder": {
            "name": "CAL_DEV"
        },
        "annotations": []
    },
    "dependsOn": [
        "[concat(variables('factoryId'), '/datasets/DS_AZURE_SQL_CAL_DEV')]",
        "[concat(variables('factoryId'), '/datasets/DS_PREVIEW_REPORT_DEV')]",
        "[concat(variables('factoryId'), '/linkedServices/LS_AzureSql_CAL_DEV')]"
    ]
}
